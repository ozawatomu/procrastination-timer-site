---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, href, absolute } from '../data/site';
import latoRegular from '../assets/fonts/lato-regular-latin.woff2?url';
import latoBold from '../assets/fonts/lato-bold-latin.woff2?url';
import robotoRegular from '../assets/fonts/roboto-regular-latin.woff2?url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  noindex = false,
  structuredData,
} = Astro.props;
const canonical = new URL(
  noindex ? href('/404.html') : Astro.url.pathname,
  site.origin,
).href;
const ogImage = absolute('/og.png');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F2F2F2" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link
      rel="icon"
      href={href('/favicon.png')}
      type="image/png"
      sizes="512x512"
    />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    {[latoRegular, latoBold, robotoRegular].map((font) => (
      <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Procrastination Timer showing Studying 1:32:07 above Procrastinating 0:04:51"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
      ></script>
    )}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
