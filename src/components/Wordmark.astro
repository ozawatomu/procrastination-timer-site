---
import { href } from '../data/site';
interface Props {
  size?: number;
}
const { size = 36 } = Astro.props;
---

<a class="wordmark" href={href('/')}>
  <img
    class="brand-mark"
    src={href('/favicon.svg')}
    alt=""
    width={size}
    height={size}
  />
  <span>Procrastination Timer</span>
</a>
