---
import { site, playUrl } from '../data/site';
interface Props {
  campaign: string;
  compact?: boolean;
}
const { campaign, compact = false } = Astro.props;
---

<div class:list={['store-buttons', { compact }]}>
  {site.android.available ? (
    <a class="store-button" href={playUrl(campaign)}>
      <svg
        width="22"
        height="24"
        viewBox="0 0 24 26"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3 2.7v20.6L15.4 13 3 2.7Z"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
        <path
          d="m3 2.7 17.5 9.1a1.35 1.35 0 0 1 0 2.4L3 23.3M10.5 6.6l7.1 8.8M10.5 19.4l7.1-8.8"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
      </svg>
      <span>
        <small>Get it on</small>
        Google Play
      </span>
    </a>
  ) : (
    <span class="store-chip">
      <svg
        width="18"
        height="20"
        viewBox="0 0 24 26"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3 2.7v20.6L15.4 13 3 2.7Z"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"
        />
        <path
          d="m3 2.7 17.5 9.1a1.35 1.35 0 0 1 0 2.4L3 23.3M10.5 6.6l7.1 8.8M10.5 19.4l7.1-8.8"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"
        />
      </svg>
      <span>
        <small>Coming soon to</small>
        Google Play
      </span>
    </span>
  )}
  {site.ios.available && site.ios.url ? (
    <a class="store-button" href={site.ios.url}>
      <svg
        width="22"
        height="24"
        viewBox="0 0 24 26"
        fill="none"
        aria-hidden="true"
      >
        <rect
          x="4"
          y="1.5"
          width="16"
          height="23"
          rx="3.5"
          stroke="currentColor"
          stroke-width="1.6"
        />
        <path
          d="M9.5 21h5"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </svg>
      <span>
        <small>Download on the</small>
        App Store
      </span>
    </a>
  ) : (
    <span class="store-chip">
      <svg
        width="18"
        height="20"
        viewBox="0 0 24 26"
        fill="none"
        aria-hidden="true"
      >
        <rect
          x="4"
          y="1.5"
          width="16"
          height="23"
          rx="3.5"
          stroke="currentColor"
          stroke-width="1.8"
        />
        <path
          d="M9.5 21h5"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        />
      </svg>
      <span>
        <small>Coming soon to the</small>
        App Store
      </span>
    </span>
  )}
</div>
