---
import SiteLayout from '../layouts/SiteLayout.astro';
import { href } from '../data/site';
---

<SiteLayout
  title="Page Not Found — Procrastination Timer"
  description="This page could not be found. Head back to the Procrastination Timer home page or the support page."
  noindex
>
  <section class="not-found wrap">
    <p class="eyebrow">404</p>
    <h1>
      Time well
      <br />
      <span>wasted.</span>
    </h1>
    <p>That page does not exist. Consider it procrastination.</p>
    <a class="nav-cta" href={href('/')}>
      Back to the timer
    </a>
    <p>
      <a class="text-link" href={href('/support/')}>
        Get support
      </a>
    </p>
  </section>
</SiteLayout>
